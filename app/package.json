{
  "name": "stagewright-app",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "parity": "cargo run -q -p stagewright -- classify ../fixtures/stage-sample/acts/*/*.scene src/lib/__fixtures__/*.scene > src/lib/__fixtures__/classify.json",
    "tauri": "tauri",
    "e2e": "node e2e/draft-scene.cjs",
    "serve": "npm run build && cargo run -q -p stagewright -- serve --static dist",
    "e2e:cowrite": "node e2e/cowrite.cjs",
    "e2e:screen": "node e2e/screenplay.cjs",
    "e2e:update": "node e2e/update.cjs",
    "e2e:cast": "node e2e/cast.cjs",
    "e2e:check": "node e2e/check.cjs",
    "e2e:layout": "node e2e/layout.cjs",
    "e2e:comments": "node e2e/comments.cjs",
    "e2e:ai": "node e2e/ai.cjs",
    "relay": "cargo run -q -p stagewright -- relay --data ../.relay-data"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "diff-match-patch": "^1.0.5",
    "svelte": "^5.57.3",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.20.5",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
